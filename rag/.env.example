DASHSCOPE_API_KEY=replace-me
RAG_API_PORT=8011
RAG_API_HOST=127.0.0.1
MCP_HOST=127.0.0.1
MCP_PORT=8010
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=
EMBEDDING_DIMENSIONS=1024

# events is the new versioned ingestion/query path; legacy selects the original HTTP upload path.
RAG_INGESTION_MODE=events
RABBITMQ_URL=amqp://rag:rag-local-password@127.0.0.1:5672/%2F
RAG_EVENT_QUEUE=rag.documents.v1
RAG_DEAD_QUEUE=rag.documents.dead.v1
RAG_EVENT_MAX_ATTEMPTS=4
RAG_EVENT_RETRY_BASE=5
RAG_OBJECT_SOURCE=local
# Optional absolute paths; by default use rag/file/events and rag/file/objects.
# RAG_EVENT_DATA_DIR=C:/your-workspace/ai-relationship-assistant/rag/file/events
# RAG_LOCAL_OBJECT_ROOT=C:/your-workspace/ai-relationship-assistant/rag/file/objects
RAG_CHROMA_HOST=127.0.0.1
RAG_CHROMA_PORT=8002
RAG_CHROMA_COLLECTION=rag_event_chunks
RAG_EMBEDDING_REVISION=1
RAG_PIPELINE_VERSION=markdown-sentence-v1
RAG_MAX_OBJECT_BYTES=104857600
RAG_TENANT_ID=default
# Optional for localhost. Configure a strong token for service-to-service HTTP calls.
RAG_SERVICE_TOKEN=

# OSS mode: immutable object key or explicit object.version_id + SHA-256.
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=
OSS_KEY_PREFIX=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# OSS_SESSION_TOKEN=
