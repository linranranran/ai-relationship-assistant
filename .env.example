# ============================================================
# 知客-销售沟通助手 — 环境变量
# 复制此文件为 .env 并填入你的配置
# ============================================================

# --- LLM API (支持 OpenAI 兼容接口) ---
# 填写所选供应商的 OpenAI 兼容地址与已开通模型；不同供应商能力分别验证。
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 仅对支持该供应商扩展的模型填写true/false；空值保持供应商默认。
# Qwen准备单响应较长时可设false，避免思考过程挤占结构化响应预算。
LLM_ENABLE_THINKING=
LLM_REQUEST_TIMEOUT_SECONDS=600
# running 幂等记录允许重试抢占的时间（秒），不是工作流执行超时。
# 本地长时间断点调试可设为 3600，且应长于前端请求等待时间。
AGENT_REQUEST_STALE_SECONDS=300
AGENT_TOOL_STALE_SECONDS=300
# Embedding 模型（DeepSeek 暂不支持 embedding，可以用其他）
EMBEDDING_API_KEY=sk-your-api-key-here
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# --- Langfuse：节点输入输出、实际提示词、模型响应及请求执行树 ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# 旧 LANGFUSE_HOST 仍兼容，正式使用选择自己的 Langfuse 项目地址。
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_TRACING_ENVIRONMENT=development
# 后台导出/API 超时；跨区域访问云端时 5 秒容易丢失观察，不影响模型请求超时。
LANGFUSE_TIMEOUT=20
# 凭据始终脱敏；超大对象会显示明确截断标记。
AGENT_AUDIT_MAX_PAYLOAD_CHARS=1000000

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j

# --- ChromaDB ---
# 本地模式，数据存于 chroma_data/ 目录
CHROMA_PERSIST_DIR=./chroma_data

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=relation-agent
POSTGRES_ADMIN_DATABASE=postgres
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_POOL_TIMEOUT_SECONDS=10

# --- LangGraph Checkpointer ---
# memory: 仅用于单进程学习脚本；可恢复流式执行使用 postgres
AGENT_CHECKPOINTER_BACKEND=postgres
# Checkpointer 使用上面的 POSTGRES_* 连接配置，但拥有独立连接池。
AGENT_CHECKPOINT_POOL_MIN_SIZE=1
AGENT_CHECKPOINT_POOL_MAX_SIZE=5
AGENT_CHECKPOINT_POOL_TIMEOUT_SECONDS=10

# --- Agent 记忆与上下文预算 ---
# PostgreSQL 可以保存完整消息，但每次只按以下预算选择上下文发送给模型。
AGENT_MAX_INPUT_TOKENS=12000
# 模拟客户聊天证据：按客户检索，不是 Agent 会话记忆。
SALES_PREP_CANDIDATE_LIMIT=100
SALES_PREP_MESSAGE_LIMIT=20
SALES_PREP_EVIDENCE_TOKEN_BUDGET=3000
AGENT_RESERVED_OUTPUT_TOKENS=2000
AGENT_CONTEXT_SAFETY_TOKENS=1000
AGENT_RECENT_MESSAGE_LIMIT=12
AGENT_SUMMARY_TRIGGER_RATIO=0.70
AGENT_MEMORY_RETRIEVAL_LIMIT=5
AGENT_SUMMARY_BATCH_LIMIT=40
AGENT_SUMMARY_MIN_MESSAGES=12
AGENT_MEMORY_WORKER_POLL_SECONDS=2
AGENT_MEMORY_JOB_STALE_SECONDS=300

# --- 服务配置 ---
HOST=0.0.0.0
PORT=8000
# 简单多用户模式：secret_key 用于生成 token
SECRET_KEY=change-me-to-a-random-string

# --- 日志 ---
LOG_LEVEL=INFO

# LangGraph 进程内流式执行与 SSE
AGENT_STREAM_MAX_RUNS=4
AGENT_RUN_LEASE_SECONDS=120
AGENT_QUEUE_LIMIT=100
AGENT_EVENT_RETENTION=5000
AGENT_SSE_POLL_SECONDS=0.5
AGENT_SSE_MAX_CONNECTIONS=100

# 单个 request_id 的累计执行预算；重试/interrupt 恢复不会重新充值。
# 区别于 AGENT_MAX_INPUT_TOKENS（限制单次上下文），这里限制整次任务。
AGENT_TASK_MAX_GOALS=4
AGENT_TASK_MAX_MODEL_CALLS=12
AGENT_TASK_MAX_TOOL_ATTEMPTS=16
AGENT_TASK_MAX_TOKENS=60000
AGENT_TASK_MAX_REPLANS=3
AGENT_TASK_MAX_CLARIFICATIONS=3
AGENT_TASK_MAX_ACTIVE_SECONDS=300
# 每次图运行的兜底步数，不能代替跨恢复的累计预算；必须 >= 8。
AGENT_TASK_RECURSION_LIMIT=64
# 优先使用供应商普遍支持的 function calling + Pydantic 校验。
LLM_STRUCTURED_METHOD=function_calling

# 三种工具决策共用执行器；配置只影响新请求，请求从数据库/Checkpoint恢复其冻结模式，移除的版本拒绝恢复。
AGENT_TOOL_STRATEGY=direct
# plan: 按 goal 生成依赖计划；direct: 完整请求循环，明确新增免确认，修改/删除及存疑新增确认。
# discovery: 保留 goal 调度，按需发现/描述/调用工具（实验）；旧请求使用其冻结版本。
AGENT_TASK_MAX_DISCOVERY_CALLS=8
AGENT_MAX_NO_PROGRESS_ROUNDS=3
# 仅在确认供应商及所有工具 Schema 支持 strict 后启用；默认仍做后端 Pydantic 校验。
AGENT_TOOL_STRICT=false
